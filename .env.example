# ---- server ----
NODE_ENV=development
PORT=8080

# PostgreSQL（本机未安装时先用 deploy/docker-compose.yml 起一个）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/whiteboard

# Redis（会话、presence、seq、广播、限流）
REDIS_URL=redis://localhost:6379

# 会话签名密钥（生产必须替换为 32 字节以上随机值）
SESSION_SECRET=dev-only-change-me-0123456789abcdef

# 游客 `wb_gid` cookie 的 HMAC-SHA256 密钥（≥32 字节，缺失即拒绝启动）
# 轮换时把旧值填到 GUEST_COOKIE_SECRET_PREV，双密钥并行验签一个窗口期
GUEST_COOKIE_SECRET=dev-guest-cookie-secret-0123456789abcdefghijklmnopqrstuv
# GUEST_COOKIE_SECRET_PREV=

# 双实例演示时用于区分实例（日志与 verify-cluster 用）
INSTANCE_ID=api-1

# 图片存储（v1.1）：本地磁盘根目录；不可写时上传返回 503 STORAGE_UNAVAILABLE
# 相对路径以 apps/server 为基准（与进程 cwd 无关），默认落 apps/server/.storage
STORAGE_ROOT=.storage
# 存储驱动：local（默认）| s3（S3 兼容对象存储，图片/缩略图/头像统一走它）
STORAGE_DRIVER=local
# 下面的 S3 配置在 STORAGE_DRIVER=s3 时必填（本地联调用 deploy 的 s3 服务：rclone serve s3）
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_BUCKET=whiteboard
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# 自建 S3（rclone serve s3 / MinIO）需要 path-style；AWS 虚拟主机风格可设 false
S3_FORCE_PATH_STYLE=true
# 资产签名 URL 密钥（缺省复用 SESSION_SECRET；显式设置需 ≥32 字节）
# ASSET_URL_SECRET=
# 签名 URL 有效期（秒）
ASSET_URL_TTL_SECONDS=900

# 生命周期清理调度（默认只在 NODE_ENV=production 开启；本地/测试保持关闭）
# 游客板过期清理：每日 03:10，30 天无编辑软删、软删满 7 天硬删
# GUEST_GC_ENABLED=true
# 资产 GC：每日 03:20；调度默认只 dry-run，真正回收还需 ASSET_GC_APPLY=true 且 production
# ASSET_GC_ENABLED=true
# ASSET_GC_APPLY=false
ASSET_GC_GRACE_HOURS=24

# GitHub OAuth：CLIENT_ID / SECRET 缺任一即视为未启用，登录页不显示入口
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 注册到 GitHub 的回调地址；留空按请求的 proto/host 推导
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/github/callback
# OAuth 回调完成后最终 302 的前端来源：开发填 http://localhost:5173，生产留空按同源
WEB_APP_ORIGIN=http://localhost:5173
# 服务端访问 GitHub 的出站代理（Node 自带 fetch 不读系统代理）；留空则依次读 HTTPS_PROXY / HTTP_PROXY
# GITHUB_PROXY=http://proxy.example.com:8080
# 仅本地假 provider / 联调代理用，生产保持默认
# GITHUB_OAUTH_BASE_URL=https://github.com
# GITHUB_API_BASE_URL=https://api.github.com

# Google OAuth：CLIENT_ID / SECRET 缺任一即视为未启用，登录页与账号设置都不显示入口
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 必须与 Google Cloud 控制台登记的重定向 URI 完全一致；留空按请求的 proto/host 推导
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
# 服务端访问 Google 的出站代理；留空则依次读 HTTPS_PROXY / HTTP_PROXY
# GOOGLE_PROXY=http://proxy.example.com:8080
# 仅本地假 provider 用，生产保持默认
# GOOGLE_OAUTH_BASE_URL=https://accounts.google.com
# GOOGLE_TOKEN_BASE_URL=https://oauth2.googleapis.com
# GOOGLE_API_BASE_URL=https://openidconnect.googleapis.com

# ---- 邮件通道（找回密码 / 邮箱验证）----
# auto（默认）= 配了 SMTP_HOST 走 SMTP，否则写日志；log = 只写日志；smtp = 强制 SMTP
MAIL_DRIVER=auto
# 开发默认无 SMTP 时会落到日志通道，注册/找回密码等流程照常可用
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# 465 端口填 true（隐式 TLS）；587 保持 false（STARTTLS）
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM='"桜花白板" <no-reply@example.com>'
