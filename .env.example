# ---- server ----
NODE_ENV=development
PORT=8080

# PostgreSQL（本机未安装时先用 deploy/docker-compose.yml 起一个）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/whiteboard

# Redis（会话、presence、seq、广播、限流）
REDIS_URL=redis://localhost:6379

# 会话签名密钥（生产必须替换为 32 字节以上随机值）
SESSION_SECRET=dev-only-change-me-0123456789abcdef

# 游客 `wb_gid` cookie 的 HMAC-SHA256 密钥（≥32 字节，缺失即拒绝启动）
# 轮换时把旧值填到 GUEST_COOKIE_SECRET_PREV，双密钥并行验签一个窗口期
GUEST_COOKIE_SECRET=dev-guest-cookie-secret-0123456789abcdefghijklmnopqrstuv
# GUEST_COOKIE_SECRET_PREV=

# 双实例演示时用于区分实例（日志与 verify-cluster 用）
INSTANCE_ID=api-1

# GitHub OAuth（**预留**：当前版本代码不读取这三项，接入 OAuth 时启用）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/github/callback
